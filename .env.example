# Copy to .env and fill in the key. .env is gitignored.
# Groq (default provider; free tier): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-key-here
LLM_MODEL=qwen/qwen3.8-27b

# Alternatives (same OpenAI-compatible client):
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
